# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side passcode for Super Admin login.
# If left empty, the first user can claim the Admin password in the Login UI.
ADMIN_PASSCODE=""

# META_APP_SECRET: Optional Meta App Secret for verifying Instagram webhook signatures.
META_APP_SECRET=""

# CLICK_SERVICE_ID / CLICK_MERCHANT_ID / CLICK_SECRET_KEY: Optional Click Merchant credentials.
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""

# PAYME_MERCHANT_ID / PAYME_SECRET_KEY: Optional Payme Merchant credentials.
PAYME_MERCHANT_ID=""
PAYME_SECRET_KEY=""

# YANDEX_DELIVERY_TOKEN: Optional Yandex Delivery Cargo API OAuth token.
YANDEX_DELIVERY_TOKEN=""
